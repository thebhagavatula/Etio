<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Etio" parent="android:Theme.Material.NoActionBar" />

    <!-- Shown for the brief window between process start and the first Compose
         frame. androidx.core.splashscreen backports the Android 12 API down to
         minSdk 26, so this looks the same on every device Etio runs on. Reuses
         the adaptive icon's foreground layer — one glyph, one place it's drawn. -->
    <style name="Theme.Etio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/etio_slate</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Etio</item>
    </style>
</resources>
