# Three people on Windows machines. Without this, CRLF churn makes every diff
# look like a whole-file rewrite and every merge look like a conflict.
* text=auto eol=lf

*.bat        text eol=crlf
gradlew      text eol=lf
*.kt         text diff=java
*.kts        text diff=java
*.java       text diff=java
*.md         text
*.json       text
*.xml        text
*.toml       text
*.pro        text

# Binary — never try to merge these.
*.jar        binary
*.task       binary
*.bin        binary
*.tflite     binary
*.png        binary
*.jpg        binary
*.webp       binary
*.keystore   binary
